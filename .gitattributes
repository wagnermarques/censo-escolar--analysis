# Sem a regra abaixo, um checkout no Windows converteria os arquivos de texto
# para CRLF e o próximo commit viraria um diff de arquivo inteiro, escondendo
# a mudança real.
* text=auto eol=lf

# Nunca normalizar: qualquer tradução de final de linha corrompe estes.
*.zip     binary
*.parquet binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.xlsx    binary
*.pem     binary

# Os microdados do INEP são latin-1, não UTF-8; sem isto o git tenta adivinhar.
*.CSV     binary
